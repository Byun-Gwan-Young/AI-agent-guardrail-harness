# agent-guardrail demo server — Caddy (C-19-7, DM-91). Installed as /etc/caddy/Caddyfile by deploy (remote-install.sh).
# No value is filled in here : {$GUARDRAIL_DOMAIN} comes from /etc/guardrail/caddy.env (root, 600 ; a systemd drop-in
# hands it to caddy.service), written by remote-install.sh from deploy/aws/target.env.
# DM-109 : no shared site password any more. DM-110 : the whole site is behind Google sign-in (forward_auth below) ;
# only /login and /api/auth/* open without it.

{$GUARDRAIL_DOMAIN} {
	# HTTPS : Caddy gets the certificate for the domain by itself.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# --- DM-110 : sign-in first. Every request except the sign-in page and sign-in API asks the backend ; no active
	# session = the backend's 303 to /login goes back to the browser. forward_auth runs before the handle blocks. ---
	@gated not path /login /api/auth/*
	forward_auth @gated 127.0.0.1:8030 {
		uri /api/auth/check
	}

	# --- service backend (DM-108, 127.0.0.1:8030) : Google sign-in page, sign-in API, the user's projects ---
	# Before @api : /api/auth/* and /api/projects* would otherwise fall into /api/*.
	@backend path /login /api/auth/* /api/projects /api/projects/*
	handle @backend {
		reverse_proxy 127.0.0.1:8030
	}

	# --- query API (C-19-6, read-only, 127.0.0.1:8020) : only these paths go to the API ---
	@api path /api/* /docs /redoc /openapi.json
	handle @api {
		reverse_proxy 127.0.0.1:8020
	}

	# --- C-19-9 : /v1/* and /sessions/* (service gateway, key-protected) blocks go here. Not open now. ---

	# --- demo screen : static files (built with --api by deploy) ---
	handle {
		root * /opt/guardrail/app/site
		file_server
	}
}
