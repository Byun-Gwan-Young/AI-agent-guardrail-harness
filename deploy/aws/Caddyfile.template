# agent-guardrail demo server — Caddy (C-19-7, DM-91). Installed as /etc/caddy/Caddyfile by deploy (remote-install.sh).
# No value is filled in here : {$GUARDRAIL_DOMAIN}, {$GUARDRAIL_BASIC_AUTH_USER} and {$GUARDRAIL_BASIC_AUTH_HASH} come
# from /etc/guardrail/caddy.env (root, 600 ; a systemd drop-in hands it to caddy.service). The password hash is put
# there on the server by set-password.sh ; the domain by remote-install.sh from deploy/aws/target.env.

{$GUARDRAIL_DOMAIN} {
	# HTTPS : Caddy gets the certificate for the domain by itself.
	encode zstd gzip

	# Temporary (DM-92 ②) : one shared password over the whole site. C-19-8 replaces it with Google sign-in.
	basic_auth {
		{$GUARDRAIL_BASIC_AUTH_USER} {$GUARDRAIL_BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# --- query API (C-19-6, read-only, 127.0.0.1:8020) : only these paths go to the API ---
	@api path /api/* /docs /redoc /openapi.json
	handle @api {
		reverse_proxy 127.0.0.1:8020
	}

	# --- C-19-8 : /auth/* (Google sign-in) block goes here. Not open now. ---

	# --- C-19-9 : /v1/* and /sessions/* (service gateway, key-protected) blocks go here. Not open now. ---

	# --- demo screen : static files (built with --api by deploy) ---
	handle {
		root * /opt/guardrail/app/site
		file_server
	}
}
