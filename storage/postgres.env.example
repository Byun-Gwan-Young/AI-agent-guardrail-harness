# Guardrail Storage PostgreSQL connection examples.
# Never commit a real password/API key/production DSN.

# ---------------------------------------------------------------------------
# Recommended server/deployment path (highest priority)
# ---------------------------------------------------------------------------
# TCP example:
# GUARDRAIL_DB_URL=postgresql://dbuser:password@127.0.0.1:5432/guardrail_agent_v2
#
# AWS/Linux Unix socket + peer authentication example (no DB password):
# GUARDRAIL_DB_URL=postgresql:///guardrail_agent_v2?host=/var/run/postgresql

# ---------------------------------------------------------------------------
# Existing local .env fallback
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guardrail_agent_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# POSTGRES_PASSWORD is optional in code. Keep it only when your local PostgreSQL
# authentication actually requires a password.

# ---------------------------------------------------------------------------
# Project/provider defaults used by storage.accounts.create_project()
# ---------------------------------------------------------------------------
# Example for the deployment-specific school gateway:
# GUARDRAIL_DEFAULT_PROVIDER=kmu
# GUARDRAIL_PROVIDER_KMU_URL=https://school-gateway.example.invalid/v1
#
# Provider API keys/credentials do NOT belong in PostgreSQL or this example file.
# Groq/OpenAI have built-in public base URLs.
#
# Custom provider endpoints are disabled by default because the proxy would
# otherwise become an SSRF path. Enable them explicitly on the server only:
# GUARDRAIL_ALLOW_CUSTOM_PROVIDER=1
# GUARDRAIL_DEFAULT_UPSTREAM_URL=https://public-custom-provider.example/v1
#
# Even when enabled, custom endpoints must resolve only to globally routable
# public IPs; loopback/private/link-local/reserved targets are rejected.

# Optional raw-importer/CLI convenience setting:
# writable project가 정확히 1개면 자동 선택되므로 없어도 됩니다.
# read_only demo project는 자동 선택하지 않습니다.
# writable project가 여러 개일 때만 지정하세요.
# POSTGRES_PROJECT_ID=1
